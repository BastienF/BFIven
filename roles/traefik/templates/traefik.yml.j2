entryPoints:
  web:
    address: ":80"
{% if traefik_https_only|bool %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
{% endif %}

  websecure:
    address: ":443"
{% if traefik_proxy_protocol_trusted_ips | length > 0 %}
    # Client address sent by a TCP relay in front (PROXY protocol header), used by the ipAllowList middlewares.
    # Optional: connections from these addresses without the header, and from any other address, work as before.
    proxyProtocol:
      trustedIPs: {{ traefik_proxy_protocol_trusted_ips | to_json }}
{% endif %}

log:
  level: "INFO"

certificatesResolvers:
  lteResolver:
    acme:
      email: "{{ traefik_le_contact_email }}"
      storage: "{{ traefik_container_certs_location }}/acme.json"
{% if traefik_le_staging|bool %}
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      httpChallenge:
        entryPoint: web

providers:
  docker:
    endpoint: "tcp://{{ traefik_docker_proxy_container_name }}:2375"
    watch: true
    network: "{{ bfiven_docker_network }}"
    exposedbydefault: false
  # Services running on the host, not in a container (see traefik_host_network)
  file:
    directory: "{{ traefik_container_dynamic_conf_location }}"
    watch: true

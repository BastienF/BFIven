#!/usr/sbin/nft -f
# {{ ansible_managed }}
# The whole ruleset of this single-purpose instance

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        meta l4proto { icmp, ipv6-icmp } accept
        # DHCP lease renewals
        udp sport 67 udp dport 68 accept
        # Also filtered by the security group: the hypervisor only
        tcp dport 22 accept
    }

    # From bfiven's Chrome to the Internet only, IPv4 only; the replies through "ct state established"
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "{{ coursator_sortie_interface }}" oifname "{{ ansible_default_ipv4.interface }}" ip saddr {{ coursator_sortie_client_address }} ip daddr != { {{ coursator_sortie_gateway_denied_networks | join(', ') }} } accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }

    # The Internet's TCP segments must fit in the tunnel
    chain clamp {
        type filter hook forward priority mangle; policy accept;

        oifname "{{ coursator_sortie_interface }}" tcp flags syn tcp option maxseg size set rt mtu
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "{{ ansible_default_ipv4.interface }}" ip saddr {{ coursator_sortie_client_address }} masquerade
    }
}
